{
  "name": "@local/dsh-memory-graph",
  "version": "0.2.0",
  "type": "module",
  "description": "Long-term associative memory for DeepSeek Harness: a local plain-text vault of raw episodes, typed memory cards and entity pages. Zero dependencies, no build step.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "cordis",
    "memory",
    "long-term-memory",
    "knowledge-graph",
    "local-first"
  ],
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "src/*.js",
    "test/*.mjs",
    "eval/*.mjs",
    "eval/questions.json",
    "eval/REPORT.md",
    "cordis.patch.yml",
    "docs/*.png",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node test/smoke.mjs && node test/capture.mjs && node test/tools.mjs && node test/extract.mjs && node eval/run.mjs",
    "eval": "node eval/run.mjs",
    "live": "node test/live.mjs",
    "live:supersede": "node test/live-supersede.mjs",
    "check": "node --check index.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT"
}
